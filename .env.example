# Copy to .env and fill in. Never commit .env.

# Qloo hackathon key (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide).
# Leave empty to run on the built-in mock data. On a public server set QLOO_MODE=live so a
# missing key stops the server instead of silently falling back to mock data.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# QLOO_MODE=live
# QLOO_DAILY_BUDGET=600

# Azure OpenAI deployment used by the agent (Responses API with function tools).
# Leave the key empty, or set AI_PROVIDER=off, to run with fixed rules and templates.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Name shown in the page footer
AZURE_OPENAI_MODEL=GPT-6.1

# Optional
# PORT=8795
# HOST=127.0.0.1
# PUBLIC_URL=https://wayin.example.com
# RUNS_PER_IP_PER_HOUR=60
# LOOKUPS_PER_IP_PER_HOUR=300
# MODEL_RUNS_PER_DAY=300
# WORKSPACES_PER_IP_PER_HOUR=20
